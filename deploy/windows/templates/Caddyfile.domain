# Sofia's Resto-Lounge - public domain with an automatic Let's Encrypt certificate (generated by Install-Sofia.ps1).
# Requirements: the domain's DNS points to this restaurant's public IP and the router forwards ports 80 and 443 here.
# PostgreSQL is never exposed: only Caddy listens on the network.
{
	admin off
	email {EMAIL}
	storage file_system {ROOT}/caddy/data
	log {
		output file {ROOT}/logs/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

{DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:{PORT} {
		flush_interval -1
	}
}
