# Sofia's Resto-Lounge - HTTPS on the restaurant network (generated by Install-Sofia.ps1).
# Caddy runs a private certificate authority. Every tablet/phone installs its root certificate once
# (http://{LAN_IP}/sofia-ca.crt); after that the browser trusts https://{LAN_IP} and offline mode works.
{
	admin off
	storage file_system {ROOT}/caddy/data
	skip_install_trust
	log {
		output file {ROOT}/logs/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

https://{LAN_IP}, https://{HOSTNAME}, https://localhost {
	tls internal
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:{PORT} {
		flush_interval -1
	}
}

http://{LAN_IP}, http://{HOSTNAME} {
	handle /sofia-ca.crt {
		root * {ROOT}/https
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir https://{host}{uri} 308
	}
}
